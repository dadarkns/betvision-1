# BetVision - configuracao compartilhavel de backend
# Copie este arquivo para `.env` ou `.env.local` e preencha os valores reais.
# Nunca commite `.env` ou `.env.local`.

# Ambiente do app: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Supabase Auth / Database
# Valores publicos do projeto Supabase. Use a anon key, nunca a service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# API esportiva
# Em desenvolvimento, a chave pode ficar aqui para facilitar testes.
# Em producao, mover para proxy/backend para nao expor a chave no web/mobile.
EXPO_PUBLIC_APISPORTS_BASE_URL=https://v3.football.api-sports.io
EXPO_PUBLIC_APISPORTS_KEY=your-api-sports-key

# Controles operacionais da API esportiva
# Reduza o limite se o plano estiver perto da cota.
EXPO_PUBLIC_SPORTS_FIXTURE_LIMIT=4
EXPO_PUBLIC_SPORTS_REQUEST_TIMEOUT_MS=12000

# Versao do cache local de estatisticas.
# Altere quando mudar a normalizacao de dados e quiser ignorar caches antigos.
EXPO_PUBLIC_REAL_STATS_CACHE_VERSION=v1

# Backend local BetVision AI
# Use para testar no frontend as previsoes geradas pelo Python:
# backend\.venv\Scripts\python -m betvision_ai serve
EXPO_PUBLIC_BETVISION_AI_BASE_URL=http://127.0.0.1:8765
EXPO_PUBLIC_BETVISION_AI_TIMEOUT_MS=8000

# The Odds API
# Chave privada usada somente pelo backend Python. Nunca use prefixo EXPO_PUBLIC_.
ODDS_API_KEY=your-the-odds-api-key
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
ODDS_API_REGION=eu
ODDS_API_SPORT=soccer_fifa_world_cup
